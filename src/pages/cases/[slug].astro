---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import StatusBadge from '../../components/StatusBadge.astro';
import WorkflowMap from '../../components/WorkflowMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cases', ({ data }) => data.locale === 'ru');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'cases'> };
const { Content } = await render(entry);
const { data } = entry;

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: data.title,
  description: data.summary,
  codeRepository: data.repoUrl,
  programmingLanguage: 'n8n workflow JSON',
  author: { '@type': 'Person', name: 'Иван Новичков' },
  dateModified: data.updatedAt.toISOString(),
};
---

<BaseLayout
  title={`${data.title} — кейс VANIL / Ивана Новичкова`}
  description={data.summary}
  canonicalPath={`/cases/${data.slug}/`}
  structuredData={softwareSchema}
>
  <article>
    <header class="case-hero section">
      <div class="container">
        <a class="back-link" href="/cases/">← Все кейсы</a>
        <div class="case-hero__grid">
          <div>
            <StatusBadge status={data.status} />
            <p class="eyebrow case-hero__eyebrow">{data.eyebrow}</p>
            <h1 class="display">{data.title}</h1>
            <p class="lede">{data.summary}</p>
            <div class="button-row">
              <a class="button button--primary" href={data.repoUrl}>GitHub</a>
              {
                data.releaseUrl && (
                  <a class="button" href={data.releaseUrl}>
                    Открыть workflow
                  </a>
                )
              }
            </div>
          </div>
          <div>
            <WorkflowMap label={`Архитектура проекта ${data.title}`} steps={data.architecture} />
            <ul class="stack-list" aria-label="Стек проекта">
              {data.stack.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </header>

    {
      data.metrics.length > 0 && (
        <section class="metric-band" aria-label="Метрики кейса">
          <div class="container metric-band__grid">
            {data.metrics.map((metric) => (
              <div>
                <strong>{metric.value}</strong>
                <span>{metric.label}</span>
                <small>{metric.source}</small>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="section">
      <div class="container case-content">
        <div class="prose">
          <Content />
        </div>
        <aside>
          <section class="fact-panel">
            <p class="fact-panel__label mono">Проверено</p>
            <ul>
              {data.testedScenarios.map((scenario) => <li>{scenario}</li>)}
            </ul>
          </section>
          <section class="fact-panel fact-panel--warning">
            <p class="fact-panel__label mono">Ограничения</p>
            <ul>
              {data.limitations.map((limitation) => <li>{limitation}</li>)}
            </ul>
          </section>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .case-hero {
    padding-top: 3rem;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: clamp(3rem, 7vw, 6rem);
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .case-hero__grid,
  .case-content,
  .metric-band__grid {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .case-hero__eyebrow {
    margin-top: 2rem;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .stack-list li {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.65rem;
  }

  .metric-band {
    border-block: 1px solid var(--line);
    background: var(--paper-strong);
  }

  .metric-band__grid {
    gap: 0;
  }

  .metric-band__grid > div {
    display: flex;
    min-height: 11rem;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .metric-band strong {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .metric-band span {
    font-weight: 700;
  }

  .metric-band small {
    max-width: 28rem;
    margin-top: 0.7rem;
    color: var(--muted);
  }

  aside {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .fact-panel {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 35%);
  }

  .fact-panel--warning {
    border-color: rgb(232 93 74 / 35%);
  }

  .fact-panel__label {
    margin: 0 0 1rem;
    color: var(--coral-dark);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .fact-panel ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.15rem;
    color: var(--ink-soft);
  }

  @media (min-width: 52rem) {
    .case-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .case-content {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    }

    aside {
      position: sticky;
      top: 2rem;
    }

    .metric-band__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .metric-band__grid > div {
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }
  }
</style>
