---
import { getCollection } from 'astro:content';
import CaseCard from '../components/CaseCard.astro';
import SiteCard from '../components/SiteCard.astro';
import { sites as allSites } from '../data/sites';
import BaseLayout from '../layouts/BaseLayout.astro';

const cases = (
  await getCollection('cases', ({ data }) => data.locale === 'ru' && data.featured)
).sort((a, b) => a.data.order - b.data.order);

const sites = allSites
  .filter((site) => site.locale === 'ru' && site.featured)
  .sort((a, b) => a.order - b.order);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Иван Новичков',
  alternateName: 'VANIL',
  jobTitle: 'Разработчик сайтов и AI-автоматизаций',
  url: 'https://vanilvibecoder.github.io',
  email: 'mailto:ewan.novichkov@yandex.ru',
  sameAs: ['https://github.com/VanilVibecoder', 'https://t.me/novichkov_ivan'],
  knowsAbout: [
    'Web development',
    'TypeScript',
    'n8n',
    'AI automation',
    'PostgreSQL',
    'Qdrant',
    'RAG',
    'API integration',
  ],
};

const serviceDirections = [
  {
    number: '01',
    title: 'Сайты и веб-сервисы',
    text: 'Проектирую структуру, интерфейс и пользовательский путь. Собираю адаптивную витрину, интерактивные сценарии и понятное управление контентом.',
    link: '/sites/',
    linkLabel: 'Смотреть сайты',
  },
  {
    number: '02',
    title: 'AI и автоматизация процессов',
    text: 'Связываю заявки, поддержку, документы, данные и внешние сервисы в проверяемые workflow с правилами, AI и человеческим контролем.',
    link: '/cases/',
    linkLabel: 'Смотреть автоматизации',
  },
];

const workAreas = [
  {
    number: '01',
    title: 'Заявки и продажи',
    text: 'Приём обращений, проверка данных, квалификация, маршрутизация, уведомления и передача менеджеру.',
  },
  {
    number: '02',
    title: 'AI и базы знаний',
    text: 'RAG-поиск, контроль релевантности, ответы по документам, тикеты и улучшение базы знаний.',
  },
  {
    number: '03',
    title: 'Документы и данные',
    text: 'Извлечение, очистка, преобразование и передача информации между таблицами, базами и API.',
  },
  {
    number: '04',
    title: 'Аудит workflow',
    text: 'Поиск хрупких мест, дублей, небезопасных секретов и сценариев, которые молча ломаются в production.',
  },
];

const process = [
  ['Разбор', 'Фиксируем ручные шаги, исключения, владельцев данных и цену ошибки.'],
  ['Архитектура', 'Разделяем правила, AI-решения, хранилища и точки контроля человека.'],
  ['Сборка и тесты', 'Проверяем happy path, ошибки, повторы событий и некорректные данные.'],
  ['Передача', 'Оставляю документацию, ограничения и понятный план сопровождения.'],
];
---

<BaseLayout
  title="VANIL / Иван Новичков — сайты и AI-автоматизация"
  description="Сайты, веб-сервисы и практичные автоматизации на n8n и AI — от разбора задачи до протестированного решения с документацией."
  structuredData={personSchema}
>
  <section class="hero">
    <div class="container hero__frame">
      <img
        class="hero__image"
        src="/images/hero-automation-architecture.webp"
        width="1586"
        height="992"
        alt=""
        fetchpriority="high"
      />
      <div class="hero__copy">
        <p class="eyebrow">Иван Новичков · разработчик сайтов и AI-автоматизаций</p>
        <h1 class="display">Создаю сайты и автоматизирую ручные процессы.</h1>
        <p class="lede">
          От структуры и интерфейса сайта до n8n- и AI-workflow: разбираю задачу, собираю решение,
          проверяю сценарии и фиксирую ограничения.
        </p>
        <div class="button-row">
          <a class="button button--primary" href="https://t.me/novichkov_ivan">Обсудить задачу</a>
          <a class="button button--light" href="#works">Смотреть работы</a>
        </div>
      </div>
      <div class="hero__system" aria-label="Принцип построения решения">
        <p class="mono">Управляемое решение</p>
        <ol>
          <li><span>01</span>Задача</li>
          <li><span>02</span>Структура</li>
          <li><span>03</span>Сборка</li>
          <li><span>04</span>Проверка</li>
        </ol>
      </div>
      <p class="hero__note mono">Интерфейс и автоматизация работают на одну задачу бизнеса.</p>
    </div>
  </section>
  <section class="proof-strip" aria-label="Доказательства работы">
    <div class="container proof-strip__grid">
      <div><strong>8</strong><span>открытых работ</span></div>
      <div><strong>2</strong><span>направления разработки</span></div>
      <div><strong>95</strong><span>узлов во флагманском MVP</span></div>
      <div><strong>Live</strong><span>публичные демо и репозитории</span></div>
    </div>
  </section>

  <section id="services" class="section services-section">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Два направления</p>
          <h2 class="section-title">Интерфейс для клиента. Система для процесса.</h2>
        </div>
        <p class="lede">
          Можно начать с отдельного сайта или автоматизации — либо связать их в один понятный
          маршрут от обращения пользователя до обработки данных.
        </p>
      </div>
      <div class="service-grid">
        {
          serviceDirections.map((direction) => (
            <article class="service-card">
              <span class="service-card__number mono">{direction.number}</span>
              <h3>{direction.title}</h3>
              <p>{direction.text}</p>
              <a href={direction.link}>
                {direction.linkLabel} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="work" class="section automation-section">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Что можно автоматизировать</p>
          <h2 class="section-title">Не отрасль.<br />Повторяющуюся работу.</h2>
        </div>
        <p class="lede">
          Сначала определяю, где нужны строгие правила, где допустим AI и в какой точке решение
          должен подтвердить человек.
        </p>
      </div>
      <div class="work-grid">
        {
          workAreas.map((area) => (
            <article class="work-card">
              <span class="work-card__number mono">{area.number}</span>
              <h3>{area.title}</h3>
              <p>{area.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="works" class="section sites-section">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Сайты · работы</p>
          <h2 class="section-title">Веб-проекты, которые можно открыть.</h2>
        </div>
        <div>
          <p class="lede">
            Живая версия, пользовательские сценарии и честная граница между демонстрацией и
            клиентским проектом.
          </p>
          <a class="text-link" href="/sites/">Все сайты <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="site-grid">
        {sites.map((entry, index) => <SiteCard entry={entry} index={index} />)}
      </div>
    </div>
  </section>

  <section id="cases" class="section cases-section">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Автоматизация · работы</p>
          <h2 class="section-title">Workflow, которые можно разобрать.</h2>
        </div>
        <div>
          <p class="lede">
            Архитектура, тестовые сценарии, ограничения и безопасные экспорты — без выдуманного ROI.
          </p>
          <a class="text-link" href="/cases/">Все автоматизации <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <div class="case-grid">
        {cases.map((entry, index) => <CaseCard entry={entry} index={index} />)}
      </div>
    </div>
  </section>

  <section id="process" class="section">
    <div class="container process-grid">
      <div class="process-heading">
        <p class="eyebrow">Как работаю</p>
        <h2 class="section-title">Сначала задача.<br />Потом инструменты.</h2>
        <p class="lede">
          Полезный сайт или автоматизация начинаются с понимания пользователя, данных, исключений и
          того, кто отвечает за результат.
        </p>
      </div>
      <ol class="process-list">
        {
          process.map(([title, text], index) => (
            <li>
              <span class="mono">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="reliability section">
    <div class="container reliability__grid">
      <div>
        <p class="eyebrow">Надёжность</p>
        <h2 class="section-title">Workflow должен пережить не только демо.</h2>
      </div>
      <div class="reliability__list">
        <p><span>01</span> Валидация и единые контракты данных</p>
        <p><span>02</span> Идемпотентность и защита от дублей</p>
        <p><span>03</span> Retry, timeout и контролируемые ошибки</p>
        <p><span>04</span> Human-in-the-loop для рискованных действий</p>
        <p><span>05</span> Документация и честные ограничения</p>
      </div>
    </div>
  </section>

  <section class="about section">
    <div class="container about__grid">
      <div class="about__mark" aria-hidden="true">V</div>
      <div>
        <p class="eyebrow">VANIL / Иван Новичков</p>
        <h2 class="section-title">Практика, документация и постоянное обучение.</h2>
        <p class="lede">
          Проектирую и собираю веб-интерфейсы, а также AI-автоматизации на n8n. Работаю с
          TypeScript, PostgreSQL/Supabase, Qdrant, Ollama, Telegram и внешними API. Публичные работы
          показывают не только результат, но и сценарии, ограничения и то, что ещё требует
          доработки.
        </p>
        <div class="button-row">
          <a class="button" href="https://github.com/VanilVibecoder">Открыть GitHub</a>
          <a class="button" href="mailto:ewan.novichkov@yandex.ru">Написать на email</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
    background: var(--panel);
    color: white;
  }

  .hero__frame {
    position: relative;
    display: grid;
    min-height: min(52rem, calc(100svh - 5rem));
    align-items: center;
    isolation: isolate;
  }

  .hero__frame::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, var(--panel) 0%, rgb(14 19 25 / 96%) 28%, rgb(14 19 25 / 20%) 72%),
      linear-gradient(0deg, rgb(14 19 25 / 92%) 0%, transparent 42%);
    content: '';
  }

  .hero__image {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 47rem;
    padding-block: clamp(5rem, 11vw, 9rem) 13rem;
  }

  .hero .eyebrow {
    color: var(--apricot);
  }

  .hero .display {
    max-width: 18ch;
    font-size: clamp(2.4rem, 5.4vw, 5.2rem);
    font-weight: 570;
    letter-spacing: -0.058em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .hero .lede {
    max-width: 36rem;
    color: rgb(255 255 255 / 72%);
  }

  .hero__system {
    position: absolute;
    right: 0;
    bottom: 2rem;
    left: 0;
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 17%);
  }

  .hero__system > p,
  .hero__system ol {
    margin: 0;
  }

  .hero__system > p {
    color: rgb(255 255 255 / 46%);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__system ol {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.45rem;
    padding: 0;
    list-style: none;
  }

  .hero__system li {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    color: rgb(255 255 255 / 78%);
    font-size: 0.78rem;
  }

  .hero__system li span {
    color: var(--apricot);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.62rem;
  }

  .hero__note {
    display: none;
  }

  .proof-strip {
    border-block: 1px solid rgb(255 255 255 / 10%);
    background: var(--panel);
    color: white;
  }

  .proof-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .proof-strip__grid div {
    display: flex;
    min-height: 8.5rem;
    flex-direction: column;
    justify-content: center;
    padding: 1.2rem;
    border-right: 1px solid rgb(255 255 255 / 10%);
    border-bottom: 1px solid rgb(255 255 255 / 10%);
  }

  .proof-strip strong {
    color: var(--apricot);
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    font-weight: 560;
    letter-spacing: -0.045em;
  }

  .proof-strip span {
    color: rgb(255 255 255 / 58%);
    font-size: 0.75rem;
  }

  .section-intro,
  .process-grid,
  .reliability__grid,
  .about__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .section-intro {
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .service-grid,
  .work-grid,
  .site-grid,
  .case-grid {
    display: grid;
    gap: 1rem;
  }

  .services-section {
    border-bottom: 1px solid var(--line);
  }

  .service-card {
    display: flex;
    min-height: 24rem;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background: var(--paper-soft);
  }

  .service-card:nth-child(2) {
    border-color: rgb(255 255 255 / 12%);
    background:
      radial-gradient(circle at 82% 12%, rgb(243 182 120 / 12%), transparent 18rem), var(--panel);
    color: white;
  }

  .service-card__number {
    color: var(--coral-dark);
    font-size: 0.72rem;
  }

  .service-card:nth-child(2) .service-card__number,
  .service-card:nth-child(2) a {
    color: var(--apricot);
  }

  .service-card h3 {
    max-width: 15ch;
    margin: 3.5rem 0 1rem;
    font-size: clamp(2rem, 4vw, 3.3rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .service-card p {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
  }

  .service-card:nth-child(2) p {
    color: rgb(255 255 255 / 65%);
  }

  .service-card a {
    display: inline-flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
    color: var(--coral-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .work-card {
    min-height: 18rem;
    padding: 1.5rem;
    border-top: 1px solid var(--ink);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .work-card:hover {
    background: var(--paper-soft);
    transform: translateY(-0.25rem);
  }

  .work-card__number {
    color: var(--coral-dark);
    font-size: 0.7rem;
  }

  .work-card h3 {
    margin: 4rem 0 1rem;
    font-size: 1.55rem;
    letter-spacing: -0.035em;
  }

  .work-card p {
    margin: 0;
    color: var(--muted);
  }

  .cases-section {
    border-block: 1px solid var(--line);
    background: var(--paper-soft);
  }

  .sites-section {
    background: var(--paper-strong);
  }

  .text-link {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--coral-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .process-heading {
    align-self: start;
  }

  .process-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding-block: 1.65rem;
    border-bottom: 1px solid var(--line);
  }

  .process-list li > span {
    color: var(--coral-dark);
    font-size: 0.7rem;
  }

  .process-list h3,
  .process-list p {
    margin: 0;
  }

  .process-list h3 {
    font-size: 1.4rem;
    letter-spacing: -0.03em;
  }

  .process-list p {
    margin-top: 0.4rem;
    color: var(--muted);
  }

  .reliability {
    background:
      radial-gradient(circle at 10% 80%, rgb(243 182 120 / 9%), transparent 28rem), var(--panel);
    color: white;
  }

  .reliability .eyebrow {
    color: var(--apricot);
  }

  .reliability__list p {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    margin: 0;
    padding-block: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 14%);
  }

  .reliability__list span {
    color: var(--apricot);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.7rem;
  }

  .about__mark {
    position: relative;
    display: grid;
    overflow: hidden;
    width: min(100%, 24rem);
    aspect-ratio: 4 / 5;
    place-items: center;
    border-radius: var(--radius-large);
    background: linear-gradient(145deg, transparent 52%, rgb(243 182 120 / 16%)), var(--panel);
    box-shadow: var(--shadow);
    color: var(--apricot);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: clamp(7rem, 20vw, 13rem);
    font-weight: 500;
  }

  .about__mark::after {
    position: absolute;
    inset: 1.2rem;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: calc(var(--radius-large) - 0.4rem);
    content: '';
  }

  @media (min-width: 40rem) {
    .hero__system {
      grid-template-columns: 11rem 1fr;
      align-items: center;
    }

    .hero__system ol {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 48rem) {
    .proof-strip__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .proof-strip__grid div {
      border-bottom: 0;
    }

    .service-grid,
    .work-grid,
    .site-grid,
    .case-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .section-intro {
      grid-template-columns: 1fr 0.75fr;
    }

    .work-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .site-grid {
      grid-template-columns: 1fr;
    }

    .process-grid,
    .reliability__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .process-heading {
      position: sticky;
      top: 2rem;
    }

    .about__grid {
      grid-template-columns: 0.75fr 1.25fr;
      align-items: center;
    }
  }

  @media (max-width: 47.99rem) {
    .hero__frame {
      min-height: 45rem;
    }

    .hero__frame::after {
      background:
        linear-gradient(
          90deg,
          rgb(14 19 25 / 96%) 0%,
          rgb(14 19 25 / 72%) 68%,
          rgb(14 19 25 / 32%)
        ),
        linear-gradient(0deg, var(--panel) 0%, transparent 50%);
    }

    .hero__image {
      object-position: 64% center;
      opacity: 0.68;
    }

    .hero__copy {
      align-self: start;
      padding-block: 4.5rem 12rem;
    }
  }
</style>
