---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class:list={['brand', { 'brand--compact': compact }]} href="/" aria-label="VANIL, на главную">
  <span class="brand__mark">VANIL</span>
  <span class="brand__name">/ Иван Новичков</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .brand__mark {
    color: var(--apricot);
    font-family: 'JetBrains Mono Variable', monospace;
    letter-spacing: 0.08em;
  }

  .brand__name {
    color: rgb(255 255 255 / 62%);
    font-size: 0.88rem;
  }

  .brand--compact .brand__name {
    display: none;
  }

  @media (min-width: 34rem) {
    .brand--compact .brand__name {
      display: inline;
    }
  }
</style>
