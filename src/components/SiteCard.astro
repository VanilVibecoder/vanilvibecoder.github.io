---
import type { SiteProject } from '../data/sites';
import StatusBadge from './StatusBadge.astro';

interface Props {
  entry: SiteProject;
  index: number;
}

const { entry, index } = Astro.props;
const data = entry;
const preview = entry.gallery[0];
---

<article class="site-card">
  <a
    class="site-card__visual"
    href={`/sites/${data.slug}/`}
    aria-label={`Открыть проект: ${data.title}`}
  >
    <img src={preview.src} alt={preview.alt} width="1440" height="1000" loading="lazy" />
  </a>
  <div class="site-card__body">
    <div class="site-card__meta">
      <span class="site-card__number">{String(index + 1).padStart(2, '0')}</span>
      <StatusBadge status={data.status} />
    </div>
    <p class="site-card__eyebrow">{data.eyebrow}</p>
    <h2><a href={`/sites/${data.slug}/`}>{data.title}</a></h2>
    <p class="site-card__summary">{data.summary}</p>
    <ul class="site-card__stack" aria-label="Технологии">
      {data.stack.slice(0, 4).map((item) => <li>{item}</li>)}
    </ul>
    <a class="site-card__link" href={`/sites/${data.slug}/`}>
      Смотреть проект <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .site-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background: var(--paper-soft);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .site-card:hover {
    border-color: rgb(173 78 39 / 44%);
    box-shadow: var(--shadow);
    transform: translateY(-0.35rem);
  }

  .site-card__visual {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--line);
    background: var(--panel-soft);
  }

  .site-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 240ms ease;
  }

  .site-card:hover .site-card__visual img {
    transform: scale(1.015);
  }

  .site-card__body {
    padding: clamp(1.4rem, 3vw, 2.1rem);
  }

  .site-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-card__number {
    color: var(--coral-dark);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.75rem;
  }

  .site-card__eyebrow {
    margin: 2.5rem 0 0.75rem;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    font-weight: 620;
    letter-spacing: -0.048em;
    line-height: 1.05;
  }

  h2 a {
    text-decoration: none;
  }

  .site-card__summary {
    color: var(--ink-soft);
  }

  .site-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 2rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .site-card__stack li {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.66rem;
  }

  .site-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--coral-dark);
    font-weight: 700;
    text-decoration: none;
  }

  @media (min-width: 62rem) {
    .site-card {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    }

    .site-card__visual {
      min-width: 0;
      height: 100%;
      min-height: 34rem;
      aspect-ratio: auto;
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }

    .site-card__body {
      display: flex;
      flex-direction: column;
    }

    .site-card__stack {
      margin-top: auto;
    }
  }
</style>
